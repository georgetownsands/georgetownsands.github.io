---
import Layout from '../layouts/Layout.astro';
import FilterableDirectory from '../components/FilterableDirectory.astro';
import { RESTAURANTS } from '../data/area';
---

<Layout
  title="Duck, NC Restaurants & Dining Guide | Georgetown Sands"
  description="Explore the best restaurants in Duck, NC. From soundfront fine dining and fresh local seafood to casual beach barbecue, original Duck Donuts, and bakeries."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-ocean-950 to-slate-900 text-white py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-ocean-800/80 border border-ocean-700/80 text-ocean-200 mb-4">
          <span>Duck, NC Local Guide</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          Restaurants & Dining in Duck
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          From award-winning soundfront sunset dinners to the very first Duck Donuts and cozy coffee cottages, discover the exceptional dining scene in Duck, North Carolina.
        </p>
      </div>
    </div>
  </section>

  <!-- Dining Tip Banner -->
  <div class="max-w-6xl mx-auto px-4 -mt-6 relative z-10">
    <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-amber-900 text-xs sm:text-sm shadow-xs">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <span class="font-bold">Dining Tip:</span> In peak summer season, soundfront sunset tables fill up fast. Reserve online or call ahead!
        </div>
      </div>
      <a
        href="/map?category=restaurants"
        class="shrink-0 text-xs font-bold text-ocean-800 hover:text-ocean-950 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-amber-200 shadow-2xs hover:bg-amber-100/50 transition-colors"
      >
        <span>🗺️ View on Map</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Filterable Restaurants Directory -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <FilterableDirectory
      items={RESTAURANTS}
      directoryId="restaurants-directory"
      searchPlaceholder="Search restaurants, seafood, donuts, coffee, BBQ..."
    />
  </section>
</Layout>

