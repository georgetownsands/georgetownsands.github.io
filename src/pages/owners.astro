---
import Layout from '../layouts/Layout.astro';
import { OWNER_RESOURCES, COMMUNITY_INFO } from '../data/area';
---

<Layout
  title="Georgetown Sands Property Owners | Duck, NC"
  description="Official resources for Georgetown Sands townhome owners: HOA Enumerate Engage portal, Signature Touch property management, and Duck Police public safety registry."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-ocean-950 to-slate-900 text-white py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-ocean-800/80 border border-ocean-700/80 text-ocean-200 mb-4">
          <span>Property Owners Center</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          Georgetown Sands Owners
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Welcome to the homeowner information center. Access your official HOA portal for dues payments and documents, contact community property management, and participate in Duck town safety initiatives.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Overview Summary Bar -->
  <section class="max-w-6xl mx-auto px-4 -mt-6 relative z-10">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
      <div class="p-2 sm:border-r border-slate-100">
        <div class="w-8 h-8 mx-auto mb-2 text-ocean-600">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-sm">HOA Account Management</h3>
        <p class="text-xs text-slate-500 mt-1">Dues payments, bylaws, meeting minutes & notices</p>
      </div>

      <div class="p-2 sm:border-r border-slate-100">
        <div class="w-8 h-8 mx-auto mb-2 text-ocean-600">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-sm">Full-Service Management</h3>
        <p class="text-xs text-slate-500 mt-1">Maintenance, landscaping, pool & tennis upkeep</p>
      </div>

      <div class="p-2">
        <div class="w-8 h-8 mx-auto mb-2 text-ocean-600">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-sm">Town Public Safety</h3>
        <p class="text-xs text-slate-500 mt-1">Duck Police security camera registry & safety</p>
      </div>
    </div>
  </section>

  <!-- Main Owner Resources Section -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-10 text-center sm:text-left">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">Essential Owner Resources & Links</h2>
      <p class="text-slate-600 text-sm sm:text-base mt-2 max-w-3xl">
        Below are the key external websites and portals that every Georgetown Sands homeowner needs for association governance, physical maintenance, and local safety.
      </p>
    </div>

    <div class="space-y-8">
      {OWNER_RESOURCES.map((resource, index) => (
        <article class="bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-md hover:border-ocean-300 transition-all overflow-hidden flex flex-col lg:flex-row">
          <div class="p-6 sm:p-8 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2 mb-3">
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">
                  {resource.category}
                </span>
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${resource.badgeColor}`}>
                  {resource.badge}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-slate-900 mb-1">
                {resource.name}
              </h3>
              <p class="text-xs sm:text-sm font-medium text-ocean-700 mb-4">
                {resource.subtitle}
              </p>

              <p class="text-sm text-slate-600 leading-relaxed mb-6">
                {resource.description}
              </p>

              <div class="mb-6">
                <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
                  Key Services & Information
                </h4>
                <ul class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-slate-700">
                  {resource.features.map((feature) => (
                    <li class="flex items-start gap-2">
                      <svg class="w-4 h-4 text-coastal-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="pt-5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
              <div class="flex flex-wrap items-center gap-4 text-xs text-slate-600">
                {resource.phone && (
                  <a
                    href={`tel:${resource.phone.replace(/[^0-9]/g, '')}`}
                    class="font-medium text-slate-800 hover:text-ocean-700 flex items-center gap-1.5 transition-colors"
                  >
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                    <span>{resource.phone}</span>
                  </a>
                )}
                {resource.address && (
                  <span class="flex items-center gap-1.5 text-slate-600">
                    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>{resource.address}</span>
                  </span>
                )}
              </div>

              <a
                href={resource.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-ocean-700 hover:bg-ocean-800 text-white shadow-xs hover:shadow transition-all group"
              >
                <span>{resource.actionText}</span>
                <svg class="w-4 h-4 text-ocean-200 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Helpful HOA & Community Information -->
  <section class="max-w-6xl mx-auto px-4 pb-16">
    <div class="bg-gradient-to-br from-slate-900 to-ocean-950 rounded-3xl p-8 sm:p-12 text-white border border-slate-800 shadow-xl">
      <div class="max-w-3xl mb-8">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-coastal-500/20 text-coastal-300 border border-coastal-500/30 uppercase tracking-wider mb-3 inline-block">
          Owner Support & Contacts
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold font-serif mb-3">
          Duck Community & Town Contacts
        </h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Helpful local service contacts for Georgetown Sands owners, whether you are in residence or managing your property remotely.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-sm">
        <div class="p-4 rounded-xl bg-white/5 border border-white/10">
          <h4 class="font-bold text-white mb-1">Town of Duck Town Hall</h4>
          <p class="text-xs text-slate-400 mb-2">Permits, administration, zoning</p>
          <a href="tel:2522551234" class="text-coastal-300 hover:text-white font-medium block">
            252-255-1234
          </a>
          <a href="https://www.townofduck.com/" target="_blank" rel="noopener noreferrer" class="text-xs text-ocean-300 hover:underline mt-1 inline-block">
            townofduck.com ↗
          </a>
        </div>

        <div class="p-4 rounded-xl bg-white/5 border border-white/10">
          <h4 class="font-bold text-white mb-1">Duck Police Department</h4>
          <p class="text-xs text-slate-400 mb-2">Non-emergency dispatch</p>
          <a href="tel:2522613860" class="text-coastal-300 hover:text-white font-medium block">
            252-261-3860
          </a>
          <p class="text-xs text-slate-400 mt-1">Dial 911 for emergencies</p>
        </div>

        <div class="p-4 rounded-xl bg-white/5 border border-white/10">
          <h4 class="font-bold text-white mb-1">Duck Fire & EMS</h4>
          <p class="text-xs text-slate-400 mb-2">Station 11 non-emergency</p>
          <a href="tel:2522613929" class="text-coastal-300 hover:text-white font-medium block">
            252-261-3929
          </a>
          <p class="text-xs text-slate-400 mt-1">Dial 911 for emergencies</p>
        </div>

        <div class="p-4 rounded-xl bg-white/5 border border-white/10">
          <h4 class="font-bold text-white mb-1">Trash & Recycling</h4>
          <p class="text-xs text-slate-400 mb-2">Town collection schedule</p>
          <a href="https://www.townofduck.com/services/trash-and-recycling/" target="_blank" rel="noopener noreferrer" class="text-coastal-300 hover:text-white font-medium block">
            View Schedule ↗
          </a>
          <p class="text-xs text-slate-400 mt-1">Seasonal pickup twice weekly</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
