---
import Layout from '../layouts/Layout.astro';
import { COMMUNITY_INFO, RENTAL_AGENCIES } from '../data/area';
---

<Layout
  title="Georgetown Sands Vacation Rentals & Agencies | Duck, NC"
  description="Plan your stay at Georgetown Sands townhomes in Duck, NC. Direct beach access, community swimming pool, tennis courts, and reputable Outer Banks rental agencies."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-ocean-950 to-slate-900 text-white py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-ocean-800/80 border border-ocean-700/80 text-ocean-200 mb-4">
          <span>Vacation Rentals in Duck, NC</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          Stay at Georgetown Sands
        </h1>
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed">
          Experience classic Outer Banks oceanside living. Georgetown Sands townhomes offer 2- and 3-bedroom floor plans with private balconies, direct beach access, an on-site pool, and private tennis courts.
        </p>
      </div>
    </div>
  </section>

  <!-- Community Amenities Bar -->
  <section class="max-w-6xl mx-auto px-4 -mt-6 relative z-10">
    <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-xs grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
      <div class="p-3">
        <div class="w-8 h-8 mx-auto mb-2 text-ocean-600">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-sm">Direct Ocean Access</h3>
        <p class="text-xs text-slate-500">Private boardwalk straight to the beach</p>
      </div>

      <div class="p-3">
        <div class="w-8 h-8 mx-auto mb-2 text-ocean-600">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-sm">Community Pool</h3>
        <p class="text-xs text-slate-500">Private swimming pool with sundeck</p>
      </div>

      <div class="p-3">
        <div class="w-8 h-8 mx-auto mb-2 text-ocean-600">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-sm">Tennis Courts</h3>
        <p class="text-xs text-slate-500">Exclusive on-site courts for guests</p>
      </div>

      <div class="p-3">
        <div class="w-8 h-8 mx-auto mb-2 text-ocean-600">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          </svg>
        </div>
        <h3 class="font-bold text-slate-900 text-sm">Walk to Village</h3>
        <p class="text-xs text-slate-500">Directly on the paved Duck Trail</p>
      </div>
    </div>
  </section>

  <!-- Rental Agencies Section -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Featured Rental Agencies</h2>
      <p class="text-slate-600 text-sm">
        Georgetown Sands townhomes are managed by premier Outer Banks vacation rental firms. Click below to view current availability, floor plans, rates, and book directly.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {RENTAL_AGENCIES.map((agency) => (
        <div class="bg-white rounded-xl p-6 border border-slate-200/90 shadow-xs hover:shadow-md hover:border-ocean-300 transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900">{agency.name}</h3>
              <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-ocean-50 text-ocean-700">
                Verified
              </span>
            </div>
            <p class="text-xs font-medium text-ocean-600 mb-3 italic">
              "{agency.tagline}"
            </p>
            <p class="text-sm text-slate-600 mb-6 leading-relaxed">
              {agency.description}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
            {agency.phoneNumber && (
              <a
                href={`tel:${agency.phoneNumber.replace(/[^0-9]/g, '')}`}
                class="text-xs font-semibold text-slate-700 hover:text-ocean-700 flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>{agency.phoneNumber}</span>
              </a>
            )}
            <a
              href={agency.webSite}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-bold text-ocean-700 hover:text-ocean-900 inline-flex items-center gap-1 ml-auto"
            >
              <span>View Listings</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Owners Section -->
  <section class="max-w-6xl mx-auto px-4 pb-16">
    <div class="bg-slate-900 rounded-2xl p-8 text-white border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-xl font-bold text-white mb-2">Are you a Georgetown Sands Owner?</h2>
        <p class="text-slate-300 text-sm max-w-xl">
          Log into the official Georgetown Sands Owners Portal (GoEnumerate) for dues payments, HOA documents, governance records, and community notices.
        </p>
      </div>
      <a
        href={COMMUNITY_INFO.ownersPortalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 px-5 py-3 rounded-lg font-semibold bg-coastal-400 hover:bg-coastal-300 text-slate-950 text-sm transition-colors flex items-center gap-2"
      >
        <span>Access Owners Portal</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </section>
</Layout>

