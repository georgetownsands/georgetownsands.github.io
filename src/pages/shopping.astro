---
import Layout from '../layouts/Layout.astro';
import FilterableDirectory from '../components/FilterableDirectory.astro';
import { SHOPPING } from '../data/area';
---

<Layout
  title="Duck, NC Shopping Guide & Village Centers | Georgetown Sands"
  description="Discover shopping in Duck, NC: The Waterfront Shops, Scarborough Faire Shopping Village, Sunshine Family Pharmacy, fresh seafood markets, local wine, and boutique shoppes."
>
  <!-- Page Header -->
  <section class="bg-gradient-to-b from-ocean-950 to-slate-900 text-white py-12 md:py-16">
    <div class="max-w-6xl mx-auto px-4">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-ocean-800/80 border border-ocean-700/80 text-ocean-200 mb-4">
          <span>Duck, NC Local Guide</span>
        </div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
          Shopping & Village Centers
        </h1>
        <div class="flex flex-wrap items-center justify-between gap-4 mt-6">
          <p class="text-slate-300 text-base sm:text-lg leading-relaxed max-w-xl">
            Duck is famed for its walkable, tree-canopied boardwalk villages. Explore distinctive boutiques, independent bookstores, artisan galleries, and fresh coastal seafood markets.
          </p>
          <a
            href="/map?category=shopping"
            class="shrink-0 text-xs font-bold text-white hover:text-ocean-100 inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 border border-white/20 backdrop-blur-xs transition-colors"
          >
            <span>🗺️ View Shopping on Map</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Village Highlights Grid -->
  <section class="max-w-6xl mx-auto px-4 -mt-6 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs">
        <div class="text-xs font-bold text-ocean-700 uppercase tracking-wider mb-1">Soundfront Boardwalk</div>
        <h3 class="font-bold text-slate-900 text-base mb-1">The Waterfront Shops</h3>
        <p class="text-xs text-slate-600">Over 15 boutiques, restaurants, and sunset decks connected along the Currituck Sound boardwalk.</p>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs">
        <div class="text-xs font-bold text-ocean-700 uppercase tracking-wider mb-1">Shaded Tree Canopy</div>
        <h3 class="font-bold text-slate-900 text-base mb-1">Scarborough Faire</h3>
        <p class="text-xs text-slate-600">Tranquil village under live oaks home to Duck's Cottage Books, Treehouse Coffee, and artisan crafts.</p>
      </div>
      <div class="bg-white rounded-xl p-5 border border-slate-200 shadow-xs">
        <div class="text-xs font-bold text-ocean-700 uppercase tracking-wider mb-1">Central Village Shoppes</div>
        <h3 class="font-bold text-slate-900 text-base mb-1">Scarborough Lane</h3>
        <p class="text-xs text-slate-600">Rocking chairs on covered porches, resort apparel, Duck Donuts, and coastal souvenirs.</p>
      </div>
    </div>
  </section>

  <!-- Filterable Shopping Directory -->
  <section class="max-w-6xl mx-auto px-4 py-12">
    <FilterableDirectory
      items={SHOPPING}
      directoryId="shopping-directory"
      searchPlaceholder="Search shops, pharmacy, markets, wine, seafood, hammocks..."
    />
  </section>
</Layout>

