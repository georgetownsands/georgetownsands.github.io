---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page Not Found | Georgetown Sands"
  description="Sorry, the page you are looking for cannot be found."
>
  <div class="max-w-2xl mx-auto px-4 py-24 text-center">
    <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-ocean-100 text-ocean-700 flex items-center justify-center">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
    </div>
    <span class="text-xs font-bold uppercase tracking-wider text-ocean-600">404 Error</span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mt-2 mb-4">
      Page Not Found
    </h1>
    <p class="text-slate-600 text-sm sm:text-base mb-8 max-w-md mx-auto leading-relaxed">
      Looks like you've drifted off the boardwalk! The page you were looking for doesn't exist or has moved.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="px-5 py-2.5 rounded-lg text-sm font-semibold bg-ocean-700 hover:bg-ocean-800 text-white transition-colors"
      >
        Return Home
      </a>
      <a
        href="/restaurants"
        class="px-5 py-2.5 rounded-lg text-sm font-semibold bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 transition-colors"
      >
        Explore Restaurants
      </a>
    </div>
  </div>
</Layout>

