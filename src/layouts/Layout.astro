---
import Navbar from '../components/Navbar.astro';
import { COMMUNITY_INFO } from '../data/area';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Georgetown Sands | Oceanside Townhomes in Duck, NC",
  description = "Georgetown Sands is an oceanside townhome community in Duck, North Carolina. Discover vacation rentals, local Duck restaurants, shopping, and activities."
} = Astro.props;

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/images/georgetownsands.jpeg" />

    <!-- Google AdSense -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4783759769928317" crossorigin="anonymous"></script>
  </head>
  <body class="min-h-screen bg-sand-50 text-slate-800 flex flex-col font-sans antialiased">
    <!-- Top Utility Bar -->
    <div class="bg-ocean-950 text-ocean-100 text-xs py-1.5 px-4">
      <div class="max-w-6xl mx-auto flex flex-wrap justify-between items-center gap-2">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-coastal-400"></span>
          <span>Duck, NC • Outer Banks</span>
        </div>
        <div class="flex items-center gap-4">
          <a
            href={COMMUNITY_INFO.ownersPortalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-coastal-300 hover:text-white font-medium transition-colors flex items-center gap-1"
          >
            <span>Property Owners Portal</span>
            <svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Navigation Bar -->
    <Navbar />

    <!-- Main Page Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-300 border-t border-slate-800 mt-16">
      <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Community Info -->
          <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-4">
              <img src="/favicon.png" alt="Georgetown Sands Logo" class="w-8 h-8 rounded-full" />
              <span class="text-xl font-bold tracking-tight text-white">Georgetown Sands</span>
            </div>
            <p class="text-slate-400 text-sm mb-4 max-w-md leading-relaxed">
              An ocean-side townhome community on the northern Outer Banks in Duck, North Carolina. Steps to the Atlantic beach, community pool and tennis, and the Duck village boardwalk.
            </p>
            <div class="flex items-center gap-2 text-xs text-coastal-400">
              <svg class="w-4 h-4 text-coastal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Duck Road, Duck, NC 27949</span>
            </div>
          </div>

          <!-- Quick Navigation -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Explore Duck</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
              <li><a href="/map" class="hover:text-white transition-colors">Interactive Village Map</a></li>
              <li><a href="/rent" class="hover:text-white transition-colors">Rentals & Agencies</a></li>
              <li><a href="/restaurants" class="hover:text-white transition-colors">Restaurants & Dining</a></li>
              <li><a href="/shopping" class="hover:text-white transition-colors">Shopping & Village</a></li>
              <li><a href="/activities" class="hover:text-white transition-colors">Activities & Recreation</a></li>
            </ul>
          </div>

          <!-- Owners & Community -->
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-wider text-white mb-4">Community</h3>
            <ul class="space-y-2 text-sm">
              <li>
                <a
                  href={COMMUNITY_INFO.ownersPortalUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 text-coastal-300 hover:text-white font-medium transition-colors"
                >
                  <span>Property Owners Portal</span>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                  </svg>
                </a>
              </li>
              <li>
                <a href="https://www.townofduck.com/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                  Town of Duck Official Site
                </a>
              </li>
              <li>
                <a href="https://www.townofduck.com/parks-and-recreation/town-park-boardwalk/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
                  Duck Town Park & Boardwalk
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="border-t border-slate-800 mt-8 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-4">
          <p>© {currentYear} Georgetown Sands Townhomes. All rights reserved.</p>
          <p>Duck, North Carolina 27949</p>
        </div>
      </div>
    </footer>
  </body>
</html>

