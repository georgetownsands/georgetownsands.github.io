---
import { COMMUNITY_INFO } from '../data/area';

const pathname = Astro.url.pathname;

const navLinks = [
  { name: 'Home', href: '/' },
  { name: 'Map', href: '/map' },
  { name: 'Rent', href: '/rent' },
  { name: 'Restaurants', href: '/restaurants' },
  { name: 'Shopping', href: '/shopping' },
  { name: 'Activities', href: '/activities' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/' || pathname === '';
  }
  return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-sm transition-all">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-20">
      <!-- Logo & Brand -->
      <a href="/" class="flex items-center gap-3 group">
        <img
          src="/favicon.png"
          alt="Georgetown Sands Logo"
          class="w-10 h-10 rounded-full shadow-xs group-hover:scale-105 transition-transform"
        />
        <div>
          <span class="text-xl font-bold tracking-tight text-slate-900 group-hover:text-ocean-700 transition-colors">
            Georgetown Sands
          </span>
          <span class="block text-xs font-medium text-ocean-600 tracking-wider uppercase">
            Duck, North Carolina
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class={`px-3 py-2 rounded-md text-sm font-medium transition-colors ${
              isActive(link.href)
                ? 'bg-ocean-50 text-ocean-700 font-semibold shadow-xs'
                : 'text-slate-600 hover:text-ocean-700 hover:bg-slate-50'
            }`}
          >
            {link.name}
          </a>
        ))}

        <div class="ml-3 pl-3 border-l border-slate-200 flex items-center gap-2">
          <a
            href={COMMUNITY_INFO.ownersPortalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-coastal-50 text-coastal-800 border border-coastal-200 hover:bg-coastal-100 hover:border-coastal-300 transition-colors shadow-xs"
          >
            <span>Owners Portal</span>
            <svg class="w-3 h-3 text-coastal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </nav>

      <!-- Mobile Hamburger Button -->
      <div class="flex items-center md:hidden gap-2">
        <a
          href={COMMUNITY_INFO.ownersPortalUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold px-2.5 py-1 rounded bg-coastal-50 text-coastal-800 border border-coastal-200"
        >
          Owners
        </a>
        <button
          id="mobile-menu-button"
          type="button"
          class="p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-hidden"
          aria-label="Toggle Navigation Menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-6 space-y-2">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`block px-3 py-2.5 rounded-md text-base font-medium transition-colors ${
          isActive(link.href)
            ? 'bg-ocean-50 text-ocean-700 font-semibold'
            : 'text-slate-700 hover:bg-slate-100'
        }`}
      >
        {link.name}
      </a>
    ))}
    <div class="pt-3 border-t border-slate-100">
      <a
        href={COMMUNITY_INFO.ownersPortalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between w-full px-3 py-2.5 rounded-md text-sm font-semibold bg-coastal-50 text-coastal-800 border border-coastal-200"
      >
        <span>Property Owners Portal</span>
        <svg class="w-4 h-4 text-coastal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuBtn && menu && hamburgerIcon && closeIcon) {
    menuBtn.addEventListener('click', () => {
      const isHidden = menu.classList.toggle('hidden');
      if (isHidden) {
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });
  }
</script>

