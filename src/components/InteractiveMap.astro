---
import { COMMUNITY_INFO, RESTAURANTS, SHOPPING, ACTIVITIES, TOWN_SERVICES, type DirectoryItem } from '../data/area';

// Prepare dataset with category types
interface MapPlace extends DirectoryItem {
  type: 'restaurant' | 'shopping' | 'activity' | 'service';
}

const allPlaces: MapPlace[] = [
  ...RESTAURANTS.map(r => ({ ...r, type: 'restaurant' as const })),
  ...SHOPPING.map(s => ({ ...s, type: 'shopping' as const })),
  ...ACTIVITIES.map(a => ({ ...a, type: 'activity' as const })),
  ...TOWN_SERVICES.map(sv => ({ ...sv, type: 'service' as const })),
];

const initialDataJson = JSON.stringify(allPlaces);
const communityJson = JSON.stringify(COMMUNITY_INFO);
---

<div
  id="duck-map-wrapper"
  data-places={initialDataJson}
  data-community={communityJson}
  class="bg-white rounded-3xl border border-slate-200 shadow-md overflow-hidden flex flex-col h-[750px] lg:h-[800px] relative"
>
  <!-- Map Header Bar with Search & Filters -->
  <div class="p-4 sm:p-5 border-b border-slate-200 bg-slate-50/90 backdrop-blur-xs z-10 shrink-0">
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
      <!-- Filter Pills -->
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-filter="all"
          class="map-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all shadow-xs cursor-pointer bg-slate-900 text-white"
        >
          All Places ({allPlaces.length})
        </button>
        <button
          type="button"
          data-filter="restaurant"
          class="map-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all shadow-xs cursor-pointer bg-white text-slate-700 hover:bg-rose-50 hover:text-rose-700 border border-slate-200"
        >
          🍽️ Restaurants ({RESTAURANTS.length})
        </button>
        <button
          type="button"
          data-filter="shopping"
          class="map-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all shadow-xs cursor-pointer bg-white text-slate-700 hover:bg-emerald-50 hover:text-emerald-700 border border-slate-200"
        >
          🛍️ Shopping ({SHOPPING.length})
        </button>
        <button
          type="button"
          data-filter="activity"
          class="map-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all shadow-xs cursor-pointer bg-white text-slate-700 hover:bg-sky-50 hover:text-sky-700 border border-slate-200"
        >
          🏄 Activities ({ACTIVITIES.length})
        </button>
        <button
          type="button"
          data-filter="service"
          class="map-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all shadow-xs cursor-pointer bg-white text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 border border-slate-200"
        >
          🏛️ Services & Safety ({TOWN_SERVICES.length})
        </button>
      </div>

      <!-- Quick Search & Reset view -->
      <div class="flex items-center gap-2">
        <div class="relative flex-grow sm:w-64">
          <input
            id="map-search"
            type="text"
            placeholder="Search on map..."
            class="w-full pl-8 pr-3 py-1.5 rounded-lg border border-slate-300 text-xs focus:outline-hidden focus:ring-2 focus:ring-ocean-500"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <button
          id="btn-center-georgetown"
          type="button"
          title="Center on Georgetown Sands"
          class="px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-100 hover:bg-amber-200 text-amber-900 border border-amber-300 transition-colors flex items-center gap-1 shrink-0"
        >
          <span>⭐ Georgetown Sands</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Map + Sidebar Grid Container -->
  <div class="flex-grow flex flex-col lg:flex-row relative overflow-hidden min-h-0">
    <!-- Leaflet Map Canvas -->
    <div id="duck-map" class="w-full lg:flex-1 h-[420px] lg:h-full min-h-[380px] z-0" style="min-height: 380px; height: 100%;"></div>

    <!-- Sync'd Places Drawer / Sidebar -->
    <div class="w-full lg:w-96 bg-white border-t lg:border-t-0 lg:border-l border-slate-200 flex flex-col h-[330px] lg:h-full shrink-0 z-10 min-h-0">
      <div class="p-3 bg-slate-50 border-b border-slate-200 flex items-center justify-between text-xs font-semibold text-slate-700">
        <span>Places in Duck, NC</span>
        <span id="places-count" class="text-ocean-700 font-bold">{allPlaces.length} locations</span>
      </div>
      <div id="places-list" class="flex-grow overflow-y-auto divide-y divide-slate-100 p-2 space-y-1">
        <!-- Rendered dynamically via client JS -->
      </div>
    </div>
  </div>
</div>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  function initInteractiveMap() {
    const wrapper = document.getElementById('duck-map-wrapper');
    const mapElement = document.getElementById('duck-map');
    if (!wrapper || !mapElement) return;

    // Check if map already initialized on this element
    if ((mapElement as any)._leaflet_id) {
      return;
    }

    const places = JSON.parse(wrapper.getAttribute('data-places') || '[]');
    const community = JSON.parse(wrapper.getAttribute('data-community') || '{}');

    // Haversine distance formula in miles
    function getDistanceMiles(lat1: number, lon1: number, lat2: number, lon2: number) {
      const R = 3958.8;
      const dLat = ((lat2 - lat1) * Math.PI) / 180;
      const dLon = ((lon2 - lon1) * Math.PI) / 180;
      const a =
        Math.sin(dLat / 2) * Math.sin(dLat / 2) +
        Math.cos((lat1 * Math.PI) / 180) *
          Math.cos((lat2 * Math.PI) / 180) *
          Math.sin(dLon / 2) *
          Math.sin(dLon / 2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      return (R * c).toFixed(1);
    }

    // Pin Icons Generator
    function createCustomIcon(color: string, emoji: string) {
      return L.divIcon({
        className: 'custom-map-marker',
        html: `
          <div class="marker-pin" style="
            background-color: ${color};
            width: 32px;
            height: 32px;
            border-radius: 50% 50% 50% 0;
            transform: rotate(-45deg);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            cursor: pointer;
            transition: transform 0.15s ease-in-out;
            pointer-events: auto;
          ">
            <span style="transform: rotate(45deg); font-size: 14px; pointer-events: none;">${emoji}</span>
          </div>
        `,
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32],
      });
    }

    const icons: Record<string, L.DivIcon> = {
      community: createCustomIcon('#f59e0b', '⭐'),
      restaurant: createCustomIcon('#e11d48', '🍽️'),
      shopping: createCustomIcon('#059669', '🛍️'),
      activity: createCustomIcon('#0284c7', '🏄'),
      service: createCustomIcon('#4f46e5', '🏛️'),
    };

    const gsCoords = community.coordinates || { lat: 36.1618, lng: -75.7495 };

    // Initialize Map (disable legacy emulated tap to avoid touch glitches)
    const map = L.map(mapElement, {
      center: [36.166, -75.753],
      zoom: 14,
      scrollWheelZoom: true,
      tap: false,
    } as any);

    // Add Tile Layer
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);

    // Invalidate size once rendered
    setTimeout(() => {
      map.invalidateSize();
    }, 200);

    // Add Georgetown Sands Home Base Pin
    const gsGoogleUrl = `https://www.google.com/maps/dir/?api=1&destination=${gsCoords.lat},${gsCoords.lng}`;
    const gsAppleUrl = `https://maps.apple.com/?daddr=${gsCoords.lat},${gsCoords.lng}&q=Georgetown+Sands`;
    const gsWazeUrl = `https://waze.com/ul?ll=${gsCoords.lat},${gsCoords.lng}&navigate=yes`;

    const gsMarker = L.marker([gsCoords.lat, gsCoords.lng], { icon: icons.community }).addTo(map);
    gsMarker.bindPopup(`
      <div style="font-family: inherit; font-size: 13px; line-height: 1.4; width: 260px; max-width: 100%;">
        <span style="display: inline-block; background: #fef3c7; color: #92400e; font-weight: bold; font-size: 10px; padding: 2px 6px; border-radius: 9999px; margin-bottom: 4px;">YOUR HOME BASE</span>
        <h4 style="font-size: 15px; font-weight: bold; margin: 0 0 4px 0; color: #0f172a;">Georgetown Sands</h4>
        <p style="margin: 0 0 6px 0; color: #475569; font-size: 11px;">Oceanside townhome community with direct beach access, pool, and tennis courts on the Duck Trail.</p>
        <div style="font-weight: 600; color: #0284c7; font-size: 11px; margin-bottom: 6px;">📍 Duck Road, Duck, NC 27949</div>

        <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #e2e8f0;">
          <div style="font-size: 10px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 5px;">
            Get Directions:
          </div>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px;">
            <a href="${gsGoogleUrl}" target="_blank" rel="noopener noreferrer" class="nav-direction-btn" title="Directions via Google Maps">
              <span>Google</span>
            </a>
            <a href="${gsAppleUrl}" target="_blank" rel="noopener noreferrer" class="nav-direction-btn" title="Directions via Apple Maps">
              <span>Apple</span>
            </a>
            <a href="${gsWazeUrl}" target="_blank" rel="noopener noreferrer" class="nav-direction-btn" title="Directions via Waze">
              <span>Waze</span>
            </a>
          </div>
        </div>
      </div>
    `, {
      autoPan: true,
      autoPanPadding: [30, 30],
      maxWidth: 300,
    });

    // State
    let activeFilter = 'all';
    let searchQuery = '';
    const markersMap = new Map<string, { place: any; marker: L.Marker; dist: string }>();

    // URL parameter support
    const urlParams = new URLSearchParams(window.location.search);
    const paramCat = urlParams.get('category');
    if (paramCat) {
      if (paramCat.startsWith('rest')) activeFilter = 'restaurant';
      else if (paramCat.startsWith('shop')) activeFilter = 'shopping';
      else if (paramCat.startsWith('act')) activeFilter = 'activity';
      else if (paramCat.startsWith('serv') || paramCat.startsWith('safe')) activeFilter = 'service';
    }

    // Populate markers
    places.forEach((p: any) => {
      if (!p.coordinates) return;

      const dist = getDistanceMiles(gsCoords.lat, gsCoords.lng, p.coordinates.lat, p.coordinates.lng);
      const icon = icons[p.type] || icons.restaurant;
      const marker = L.marker([p.coordinates.lat, p.coordinates.lng], { icon });

      const googleMapsUrl = `https://www.google.com/maps/dir/?api=1&destination=${p.coordinates.lat},${p.coordinates.lng}`;
      const appleMapsUrl = `https://maps.apple.com/?daddr=${p.coordinates.lat},${p.coordinates.lng}&q=${encodeURIComponent(p.name)}`;
      const wazeUrl = `https://waze.com/ul?ll=${p.coordinates.lat},${p.coordinates.lng}&navigate=yes`;

      const popupHtml = `
        <div style="font-family: inherit; font-size: 13px; line-height: 1.4; width: 260px; max-width: 100%;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
            <span style="background: #e0f2fe; color: #0369a1; font-weight: 600; font-size: 10px; padding: 1px 6px; border-radius: 9999px;">
              ${p.category}
            </span>
            <span style="font-size: 10px; color: #64748b; font-weight: 500;">
              ${dist} mi from GS
            </span>
          </div>
          <h4 style="font-size: 15px; font-weight: bold; margin: 0 0 4px 0; color: #0f172a; line-height: 1.2;">${p.name}</h4>
          <p style="margin: 0 0 6px 0; color: #475569; font-size: 11px; max-height: 75px; overflow-y: auto;">${p.description}</p>
          ${p.address ? `<div style="font-size: 11px; color: #64748b; margin-bottom: 6px;">📍 ${p.address}</div>` : ''}

          <!-- Directions App Group -->
          <div style="margin-top: 8px; padding-top: 8px; border-top: 1px solid #e2e8f0;">
            <div style="font-size: 10px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 5px;">
              Get Directions:
            </div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 5px;">
              <a href="${googleMapsUrl}" target="_blank" rel="noopener noreferrer" class="nav-direction-btn" title="Open Google Maps">
                <span>Google</span>
              </a>
              <a href="${appleMapsUrl}" target="_blank" rel="noopener noreferrer" class="nav-direction-btn" title="Open Apple Maps">
                <span>Apple</span>
              </a>
              <a href="${wazeUrl}" target="_blank" rel="noopener noreferrer" class="nav-direction-btn" title="Open Waze">
                <span>Waze</span>
              </a>
            </div>
          </div>

          <!-- Contact & Website Links -->
          <div style="display: flex; align-items: center; justify-content: space-between; margin-top: 8px; padding-top: 6px; border-top: 1px solid #f1f5f9; font-size: 11px; font-weight: 600;">
            ${p.phoneNumber ? `<a href="tel:${p.phoneNumber.replace(/[^0-9]/g, '')}" style="color: #0284c7; text-decoration: none;">📞 ${p.phoneNumber}</a>` : '<span></span>'}
            ${p.webSite ? `<a href="${p.webSite}" target="_blank" rel="noopener noreferrer" style="color: #0284c7; text-decoration: none; margin-left: auto;">Website &rarr;</a>` : ''}
          </div>
        </div>
      `;

      marker.bindPopup(popupHtml, {
        autoPan: true,
        autoPanPadding: [30, 30],
        maxWidth: 300,
      });
      markersMap.set(p.id, { place: p, marker, dist });
    });

    const listContainer = document.getElementById('places-list');
    const countEl = document.getElementById('places-count');
    const filterBtns = document.querySelectorAll('.map-filter-btn');
    const searchInput = document.getElementById('map-search') as HTMLInputElement | null;
    const centerGsBtn = document.getElementById('btn-center-georgetown');

    function updateButtonStyles() {
      filterBtns.forEach((btn) => {
        const filter = btn.getAttribute('data-filter');
        if (filter === activeFilter) {
          btn.className =
            'map-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all shadow-xs cursor-pointer bg-slate-900 text-white';
        } else {
          btn.className =
            'map-filter-btn px-4 py-2 rounded-full text-xs font-bold transition-all shadow-xs cursor-pointer bg-white text-slate-700 hover:bg-slate-100 border border-slate-200';
        }
      });
    }

    function refreshMapAndList() {
      if (!listContainer) return;
      listContainer.innerHTML = '';
      let visibleCount = 0;

      markersMap.forEach(({ place, marker, dist }) => {
        const matchesFilter = activeFilter === 'all' || place.type === activeFilter;
        const matchesSearch =
          searchQuery === '' ||
          `${place.name} ${place.category} ${place.description} ${place.tags ? place.tags.join(' ') : ''}`
            .toLowerCase()
            .includes(searchQuery);

        if (matchesFilter && matchesSearch) {
          if (!map.hasLayer(marker)) map.addLayer(marker);
          visibleCount++;

          const card = document.createElement('div');
          card.className =
            'p-2.5 rounded-xl hover:bg-slate-50 cursor-pointer border border-transparent hover:border-slate-200 transition-all text-left';
          card.innerHTML = `
            <div class="flex items-start justify-between gap-1 mb-1">
              <span class="font-bold text-xs text-slate-900 hover:text-ocean-700">${place.name}</span>
              <span class="text-[10px] text-slate-400 shrink-0 font-medium">${dist} mi</span>
            </div>
            <div class="text-[11px] text-slate-500 line-clamp-1 mb-1">${place.description}</div>
            <div class="flex items-center gap-1.5 text-[10px]">
              <span class="px-1.5 py-0.5 rounded bg-slate-100 text-slate-600 font-semibold">${place.category}</span>
              ${place.phoneNumber ? `<span class="text-ocean-700">${place.phoneNumber}</span>` : ''}
            </div>
          `;

          card.addEventListener('click', () => {
            map.flyTo([place.coordinates.lat, place.coordinates.lng], 16, { duration: 1 });
            marker.openPopup();
          });

          listContainer.appendChild(card);
        } else {
          if (map.hasLayer(marker)) map.removeLayer(marker);
        }
      });

      if (countEl) countEl.textContent = `${visibleCount} locations`;
      updateButtonStyles();
    }

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = btn.getAttribute('data-filter') || 'all';
        refreshMapAndList();
      });
    });

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
        refreshMapAndList();
      });
    }

    if (centerGsBtn) {
      centerGsBtn.addEventListener('click', () => {
        map.flyTo([gsCoords.lat, gsCoords.lng], 15, { duration: 1 });
        gsMarker.openPopup();
      });
    }

    refreshMapAndList();
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractiveMap);
  } else {
    initInteractiveMap();
  }
</script>

<style>
  :global(.leaflet-popup-content-wrapper) {
    border-radius: 16px;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    padding: 6px;
  }
  :global(.custom-map-marker) {
    background: transparent !important;
    border: none !important;
    outline: none !important;
  }
  :global(.custom-map-marker:hover .marker-pin) {
    transform: rotate(-45deg) scale(1.18) !important;
  }
  :global(.nav-direction-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 6px 4px;
    background-color: #f8fafc;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    color: #1e293b;
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    text-align: center;
    transition: background-color 0.15s, border-color 0.15s;
  }
  :global(.nav-direction-btn:hover) {
    background-color: #e2e8f0;
    border-color: #94a3b8;
  }
</style>
