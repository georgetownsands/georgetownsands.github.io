---
import type { DirectoryItem } from '../data/area';

export interface Props {
  item: DirectoryItem;
}

const { item } = Astro.props;

// Build navigation URLs for user's map choice
const googleMapsUrl = item.coordinates
  ? `https://www.google.com/maps/dir/?api=1&destination=${item.coordinates.lat},${item.coordinates.lng}`
  : item.address
  ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${item.name}, ${item.address}`)}`
  : null;

const appleMapsUrl = item.coordinates
  ? `https://maps.apple.com/?daddr=${item.coordinates.lat},${item.coordinates.lng}&q=${encodeURIComponent(item.name)}`
  : item.address
  ? `https://maps.apple.com/?daddr=${encodeURIComponent(`${item.name}, ${item.address}`)}`
  : null;

const wazeUrl = item.coordinates
  ? `https://waze.com/ul?ll=${item.coordinates.lat},${item.coordinates.lng}&navigate=yes`
  : item.address
  ? `https://waze.com/ul?q=${encodeURIComponent(`${item.name}, ${item.address}`)}&navigate=yes`
  : null;
---

<div
  class="group bg-white rounded-xl border border-slate-200/90 hover:border-ocean-300 shadow-xs hover:shadow-md transition-all flex flex-col h-full overflow-hidden"
  data-name={item.name.toLowerCase()}
  data-category={item.category.toLowerCase()}
  data-tags={item.tags ? item.tags.join(' ').toLowerCase() : ''}
  data-description={item.description.toLowerCase()}
>
  <div class="p-6 flex flex-col flex-grow">
    <!-- Header: Category & Name -->
    <div class="flex items-start justify-between gap-3 mb-2">
      <span class="inline-block px-2.5 py-0.5 rounded-full text-xs font-medium bg-ocean-50 text-ocean-700 border border-ocean-100">
        {item.category}
      </span>
      {item.featured && (
        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200">
          <svg class="w-3 h-3 text-amber-500 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          Featured
        </span>
      )}
    </div>

    <h3 class="text-xl font-bold text-slate-900 group-hover:text-ocean-700 transition-colors mb-2">
      {item.webSite ? (
        <a
          href={item.webSite}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:underline flex items-center justify-between"
        >
          <span>{item.name}</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:text-ocean-600 shrink-0 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      ) : (
        item.name
      )}
    </h3>

    <!-- Description -->
    <p class="text-slate-600 text-sm leading-relaxed mb-4 flex-grow">
      {item.description}
    </p>

    <!-- Tags -->
    {item.tags && item.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {item.tags.map((tag) => (
          <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-slate-100 text-slate-600">
            #{tag}
          </span>
        ))}
      </div>
    )}

    <!-- Address & Phone Details -->
    <div class="pt-4 border-t border-slate-100 text-xs text-slate-600 space-y-2 mt-auto">
      {item.address && (
        <div class="flex items-start gap-2">
          <svg class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          {googleMapsUrl ? (
            <a
              href={googleMapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-ocean-700 hover:underline"
              title="Get directions on Google Maps"
            >
              {item.address}
            </a>
          ) : (
            <span>{item.address}</span>
          )}
        </div>
      )}

      {item.phoneNumber && (
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <a
            href={`tel:${item.phoneNumber.replace(/[^0-9]/g, '')}`}
            class="font-semibold text-ocean-700 hover:text-ocean-900 hover:underline"
          >
            {item.phoneNumber}
          </a>
        </div>
      )}
    </div>
  </div>

  <!-- Action Footer with Direction Choices -->
  <div class="bg-slate-50 px-5 py-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 text-xs">
    {googleMapsUrl && (
      <div class="flex items-center gap-1.5 text-slate-500 font-medium">
        <span class="text-[11px] font-semibold text-slate-600">Directions:</span>
        <div class="inline-flex items-center rounded-lg border border-slate-200 bg-white p-0.5 shadow-2xs">
          <a
            href={googleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-2 py-0.5 rounded text-[11px] font-semibold text-slate-700 hover:text-ocean-700 hover:bg-slate-50 transition-colors"
            title="Directions via Google Maps"
          >
            Google
          </a>
          <span class="text-slate-300 text-[10px]">|</span>
          <a
            href={appleMapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-2 py-0.5 rounded text-[11px] font-semibold text-slate-700 hover:text-ocean-700 hover:bg-slate-50 transition-colors"
            title="Directions via Apple Maps"
          >
            Apple
          </a>
          <span class="text-slate-300 text-[10px]">|</span>
          <a
            href={wazeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-2 py-0.5 rounded text-[11px] font-semibold text-slate-700 hover:text-ocean-700 hover:bg-slate-50 transition-colors"
            title="Directions via Waze"
          >
            Waze
          </a>
        </div>
      </div>
    )}
    {item.webSite && (
      <a
        href={item.webSite}
        target="_blank"
        rel="noopener noreferrer"
        class="ml-auto inline-flex items-center gap-1 font-semibold text-ocean-700 hover:text-ocean-900 transition-colors"
      >
        <span>Visit Website</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    )}
  </div>
</div>

